{
  "name": "root",
  "private": true,
  "workspaces": [
    "packages/formx-renderer",
    "packages/designable-react",
    "packages/designable-settings-form"
  ],
  "scripts": {
    "bootstrap": "lerna bootstrap",
    "clean": "lerna clean",
    "link": "lerna link",
    "build": "lerna run build --stream",
    "version:patch": "lerna version patch --no-git-tag-version --no-push --yes",
    "version:minor": "lerna version minor --no-git-tag-version --no-push --yes",
    "version:beta": "lerna version prerelease --preid beta --no-push --no-private --yes",
    "pub:beta": "cross-env npm run version:beta && lerna publish from-package --no-private --dist-tag beta --yes",
    "pub": "lerna publish from-package --no-private --no-git-reset --yes"
  },
  "resolutions": {
